# ============================================================
# Secure Elder Care — Environment Variables Template
# Copy this file to .env, fill in real values, never commit .env
# ============================================================

# MongoDB (Atlas or self-hosted)
MONGODB_URI=mongodb+srv://<user>:<password>@cluster.mongodb.net/?retryWrites=true&w=majority
MONGODB_DB_NAME=secure_elder_care

# JWT — CHANGE THIS to a randomly generated 256-bit secret before deploying
# Generate: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=CHANGE_ME_generate_with_python_secrets
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=60

# Backend ports
AUTH_BACKEND_PORT=8000
FACE_BACKEND_PORT=8001
TRACKING_BACKEND_PORT=8002
ANOMALY_BACKEND_PORT=8003
SCHEDULE_BACKEND_PORT=8004
GATEWAY_BACKEND_PORT=8005
MARKETPLACE_BACKEND_PORT=8006

# Frontend ports
AUTH_FRONTEND_PORT=5173
FACE_FRONTEND_PORT=5174
TRACKING_FRONTEND_PORT=5175
ANOMALY_FRONTEND_PORT=5176
SCHEDULE_FRONTEND_PORT=5177
GATEWAY_FRONTEND_PORT=5178
MARKETPLACE_FRONTEND_PORT=5179

# Service base URLs — used by gateway and inter-service calls
# In Docker: these are overridden by docker-compose environment: block
# In local dev: keep as localhost
AUTH_SERVICE_URL=http://localhost:8000
FACE_SERVICE_URL=http://localhost:8001
TRACKING_SERVICE_URL=http://localhost:8002
ANOMALY_SERVICE_URL=http://localhost:8003
SCHEDULE_SERVICE_URL=http://localhost:8004
GATEWAY_SERVICE_URL=http://localhost:8005
MARKETPLACE_SERVICE_URL=http://localhost:8006

# Frontend URLs (used by frontends for cross-service redirects)
VITE_AUTH_FRONTEND_URL=http://localhost:5173
VITE_GATEWAY_BACKEND_URL=http://localhost:8005/api/gateway
VITE_CAREGIVER_BACKEND_URL=http://localhost:8006/api/caregiver

# IP Camera (optional, Hikvision-compatible)
IP_CAMERA_HOST=
IP_CAMERA_USER=admin
IP_CAMERA_PASS=
IP_CAMERA_SNAPSHOT_URL=
IP_CAMERA_RTSP_URL=

# Email Notifications (SMTP)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_password
SMTP_FROM_EMAIL=your_email@gmail.com

# SMS Notifications (Twilio, optional)
TWILIO_SID=
TWILIO_AUTH=
TWILIO_PHONE=

# Cloudflare Tunnel (production only)
CLOUDFLARE_TUNNEL_URL=
